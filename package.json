{
  "name": "@hyperstar/mcp",
  "version": "0.1.23",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Local stdio MCP server and CLI for Hyperstar headless workflows in Claude Code and Claude Desktop.",
  "keywords": [
    "hyperstar",
    "hyperstarai",
    "hyper-star",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "claude-desktop",
    "stdio",
    "creator-search",
    "influencer-marketing",
    "agent-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyperstar-org/hyperstar-mcp.git"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "hyperstar-mcp": "dist/index.js",
    "hyperstar": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/npm-clean-room-smoke.mjs",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "validate:mcpb": "node scripts/validate-mcpb.mjs build/mcpb/hyperstar-mcp-${npm_package_version}.mcpb",
    "smoke:dev": "npm run build && node scripts/dev-smoke.mjs",
    "smoke:npm": "node scripts/npm-clean-room-smoke.mjs",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
